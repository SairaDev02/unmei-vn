// Default look §3's title door: Settings over the pack's backdrop and the veil,
// in §4's page shape — a 420px left column with only the Settings entry and
// `Back to title`, a hairline, and the shared Settings body in the right column.
//
// The body is the one `settings.ron` draws, and the format has no include, so
// this file repeats it. It differs where the surface table does: the heading is
// a `text` node here (this door's table has no `settings.heading` slot) and the
// section entry uses the same key, because the copy table owns no
// `contents.section.*` label.
(
    kind: "box",
    component: "page",
    children: [
        (kind: "slot",
            slot: "title.backdrop",
            position: "absolute",
            left: 0.0,
            top: 0.0,
            width: "fill",
            height: "fill",
        ),
        (kind: "box", component: "veil"),
        (kind: "box",
            component: "rail",
            children: [
                (kind: "text",
                    text: "settings.heading",
                    typography: "{typography.heading}",
                    fill: "{colors.text}",
                ),
                (kind: "box", component: "spacer"),
                (kind: "box",
                    direction: "row",
                    width: "fill",
                    children: [
                        (kind: "box",
                            component: "button",
                            children: [
                                (kind: "slot", slot: "settings.back",
                                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            ],
                        ),
                    ],
                ),
            ],
        ),
        (kind: "box", component: "divider"),
        (kind: "box",
            component: "column",
            children: [
                (kind: "slot", slot: "pack.name",
                    typography: "{typography.heading}",
                    color: "{colors.text}"),
                (kind: "text",
                    text: "settings.group.audio",
                    typography: "{typography.group}",
                    fill: "{colors.dim}",
                ),
                (kind: "list",
                    list: "settings.audio-rows",
                    item: (kind: "box",
                        component: "row",
                        children: [
                            (kind: "slot", slot: "settings.audio.label", width: "{spacing.settings-label}"),
                            (kind: "box", component: "track"),
                            (kind: "slot", slot: "settings.audio.value",
                            typography: "{typography.value}",
                            color: "{colors.text}"),
                            (kind: "slot", slot: "settings.master",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            (kind: "slot", slot: "settings.music",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            (kind: "slot", slot: "settings.sfx",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                        ],
                    ),
                ),
                (kind: "box",
                    component: "row",
                    children: [
                        (kind: "slot", slot: "settings.mute",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
                (kind: "box",
                    direction: "row",
                    width: "fill",
                    children: [
                        (kind: "box",
                            component: "button",
                            children: [
                                (kind: "slot", slot: "settings.reset-audio",
                                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            ],
                        ),
                    ],
                ),
                (kind: "text",
                    text: "settings.group.play",
                    typography: "{typography.group}",
                    fill: "{colors.dim}",
                ),
                (kind: "box",
                    component: "row",
                    children: [
                        (kind: "slot", slot: "settings.text-speed",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
                (kind: "box",
                    component: "row",
                    children: [
                        (kind: "slot", slot: "settings.auto",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
                (kind: "box",
                    component: "row",
                    children: [
                        (kind: "slot", slot: "settings.fullscreen",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
                (kind: "box",
                    direction: "row",
                    width: "fill",
                    children: [
                        (kind: "box",
                            component: "button",
                            children: [
                                (kind: "slot", slot: "settings.reset-play",
                                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            ],
                        ),
                    ],
                ),
                (kind: "text",
                    text: "settings.group.decisions",
                    typography: "{typography.group}",
                    fill: "{colors.dim}",
                ),
                (kind: "box",
                    component: "key-row",
                    children: [
                        (kind: "slot", slot: "settings.key-state"),
                        (kind: "slot", slot: "settings.key-placeholder",
                        color: "{colors.faint}"),
                        (kind: "slot", slot: "settings.key",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
                (kind: "slot", slot: "settings.key-path",
                typography: "{typography.value}",
                color: "{colors.faint}"),
                (kind: "box",
                    component: "row",
                    children: [
                        (kind: "slot", slot: "settings.copy-path-label"),
                        (kind: "slot", slot: "settings.copy-path",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
                (kind: "box",
                    component: "row",
                    children: [
                        (kind: "slot", slot: "settings.clear-key",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
            ],
        ),
    ],
)
