// The Settings body opened from the contents page: the interior the current
// view draws today, in the same three groups and walk order (Audio, Play,
// Decisions), with the body's own heading as the engine slot the surface
// requires.
//
// The control labels are engine content: the engine resolves a control's own
// words from the copy table. The rows, buttons and the key row carry the face and
// tone each label and value draws with, so the controls inside them name neither.
// The audio list is the exception it is in the format: its label and value are
// per-item slots, so a row places them.
//
// The body takes the width its host gives it and keeps its own natural height:
// the engine mounts it inside the Settings viewport, which scrolls whatever runs
// past it, so a `height: "fill"` here would cut the content to the viewport and
// leave nothing to scroll.
(
    kind: "box",
    direction: "column",
    width: "fill",
    padding: "{spacing.page-padding}",
    gap: "{spacing.section-gap}",
    children: [
        (kind: "slot", slot: "settings.heading",
            typography: "{typography.heading}",
            color: "{colors.text}"),
        // Audio: the three slider rows, Mute and Reset audio.
        (kind: "text",
            text: "settings.group.audio",
            typography: "{typography.group}",
            fill: "{colors.dim}",
        ),
        (kind: "list",
            list: "settings.audio-rows",
            // A list takes no gap, so the item's own padding is the 16px the hand-
            // built rows kept between their panels: an 8px pad above and below a
            // 36px panel gives the same 52px pitch the view drew before the tree
            // had it (`docs/title-and-menu.md` § Title layout §5).
            item: (kind: "box",
                direction: "column",
                padding: (top: "{spacing.settings-row-pad-y}", right: 0.0, bottom: "{spacing.settings-row-pad-y}", left: 0.0),
                children: [
                    (kind: "box",
                        component: "row",
                        children: [
                            (kind: "slot", slot: "settings.audio.label", width: "{spacing.settings-label}"),
                            (kind: "box", component: "track"),
                            (kind: "slot", slot: "settings.audio.value",
                                typography: "{typography.value}",
                                color: "{colors.text}"),
                            // The row's own control covers it, so the focus ring frames
                            // the row the engine shows rather than one child of it.
                            (kind: "slot", slot: "settings.master",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            (kind: "slot", slot: "settings.music",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            (kind: "slot", slot: "settings.sfx",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                        ],
                    ),
                ],
            ),
        ),
        (kind: "box",
            component: "row",
            children: [
                // The control covers the row, so its ring frames the panel and the
                // label it draws sits on the row's line with the value beside it.
                (kind: "slot", slot: "settings.mute",
                    position: "absolute",
                    left: 0.0,
                    top: 0.0,
                    width: "fill",
                    height: "fill",
                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
                (kind: "box", height: "{spacing.settings-row-line}"),
            ],
        ),
        (kind: "box",
            direction: "row",
            width: "fill",
            children: [
                (kind: "box",
                    component: "button",
                    children: [
                        (kind: "slot", slot: "settings.reset-audio",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
            ],
        ),
        // Play: text speed, Auto, Fullscreen and Reset play.
        (kind: "text",
            text: "settings.group.play",
            typography: "{typography.group}",
            fill: "{colors.dim}",
        ),
        // The stepped row: the control covers the row, so its ring frames the panel
        // as the audio rows' do, and the player centres the label it draws. On the
        // row's line sit the label column, the track and the value — the two engine-
        // mounted pieces keep their places as empty boxes, the track then the value
        // (`docs/title-and-menu.md` § Title layout §5).
        (kind: "box",
            component: "row",
            children: [
                (kind: "slot", slot: "settings.text-speed",
                    position: "absolute",
                    left: 0.0,
                    top: 0.0,
                    width: "fill",
                    height: "fill",
                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
                (kind: "box", width: "{spacing.settings-label}"),
                (kind: "box", component: "track"),
                (kind: "box"),
            ],
        ),
        (kind: "box",
            component: "row",
            children: [
                // The control covers the row, so its ring frames the panel and the
                // label it draws sits on the row's line with the value beside it.
                (kind: "slot", slot: "settings.auto",
                    position: "absolute",
                    left: 0.0,
                    top: 0.0,
                    width: "fill",
                    height: "fill",
                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
                (kind: "box", height: "{spacing.settings-row-line}"),
            ],
        ),
        (kind: "box",
            component: "row",
            children: [
                // The control covers the row, so its ring frames the panel and the
                // label it draws sits on the row's line with the value beside it.
                (kind: "slot", slot: "settings.fullscreen",
                    position: "absolute",
                    left: 0.0,
                    top: 0.0,
                    width: "fill",
                    height: "fill",
                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
                (kind: "box", height: "{spacing.settings-row-line}"),
            ],
        ),
        (kind: "box",
            direction: "row",
            width: "fill",
            children: [
                (kind: "box",
                    component: "button",
                    children: [
                        (kind: "slot", slot: "settings.reset-play",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
            ],
        ),
        // Decisions: the key row, where the file is stored, Copy path and
        // Clear key.
        (kind: "text",
            text: "settings.group.decisions",
            typography: "{typography.group}",
            fill: "{colors.dim}",
        ),
        (kind: "box",
            component: "key-row",
            children: [
                (kind: "slot", slot: "settings.key-state"),
                (kind: "slot", slot: "settings.key-placeholder",
                    color: "{colors.faint}"),
                (kind: "slot", slot: "settings.key",
                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
            ],
        ),
        (kind: "slot", slot: "settings.key-path",
            typography: "{typography.value}",
            color: "{colors.faint}"),
        (kind: "box",
            component: "row",
            children: [
                (kind: "slot", slot: "settings.copy-path-label"),
                (kind: "slot", slot: "settings.copy-path",
                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
            ],
        ),
        (kind: "box",
            component: "row",
            children: [
                (kind: "slot", slot: "settings.clear-key",
                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
            ],
        ),
        (kind: "box",
            direction: "row",
            width: "fill",
            children: [
                (kind: "box",
                    component: "button",
                    children: [
                        (kind: "slot", slot: "settings.back",
                            focused: (border: (width: 2.0, color: "{colors.focus}"))),
                    ],
                ),
            ],
        ),
    ],
)
