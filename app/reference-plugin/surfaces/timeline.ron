// The Timeline interior: the heading and walk legend over the explanatory line,
// the empty line for a pack that declares no scenes, and one card per declared
// scene (Default look §4, spec §11).
//
// The way out is the contents page's left column, so this surface authors no
// back control and no rail: `MenuAction::TimelineBack` stays the menu's click
// twin of `Esc`, keyed by control id and not by a node here.
//
// A card's control is the indexed family `timeline.card.<n>`: the template
// places one member and the engine numbers it per item. A visited card shows its
// raw scene id in the text tone and selects; a locked card's control is
// `disabled`, which draws its `timeline.locked` label in the faint tone — the
// approved geometry's two label tones, from this tree's own tokens.
//
// Three things the format has no property for, so the player mounts them into
// these nodes: the card list is laid out as the measured two-column grid inside
// the scrolling body, a card keeps its 136px height from the `timeline-card`
// component while the grid supplies its width, and a card's label wraps inside a
// long scene id rather than truncating (`docs/title-and-menu.md` § Timeline
// `### Layout`).
(
    kind: "box",
    direction: "column",
    width: "fill",
    height: "fill",
    padding: "{spacing.page-padding}",
    gap: "{spacing.section-gap}",
    children: [
        (kind: "box",
            component: "heading-row",
            justify_content: "space-between",
            children: [
                (kind: "text",
                    text: "timeline.heading",
                    typography: "{typography.subheading}",
                    fill: "{colors.text}",
                ),
                (kind: "text",
                    text: "timeline.legend",
                    typography: "{typography.legend}",
                    fill: "{colors.faint}",
                ),
            ],
        ),
        (kind: "slot", slot: "timeline.explanation",
            typography: "{typography.label}",
            color: "{colors.dim}"),
        (kind: "slot", slot: "timeline.empty",
            typography: "{typography.label}",
            color: "{colors.faint}"),
        (kind: "list",
            list: "timeline.cards",
            width: "fill",
            item: (kind: "box",
                component: "timeline-card",
                width: "fill",
                children: [
                    (kind: "slot", slot: "timeline.card.label",
                        typography: "{typography.group}",
                        color: "{colors.text}",
                        disabled: (color: "{colors.faint}")),
                    (kind: "slot", slot: "timeline.card.1",
                        position: "absolute",
                        left: 0.0,
                        top: 0.0,
                        width: "fill",
                        height: "fill",
                        focused: (border: (width: 2.0, color: "{colors.focus}"))),
                ],
            ),
        ),
    ],
)
