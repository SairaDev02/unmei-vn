// Default look §3: the title's left column, the rows and the veil.
//
// The rows are text-only, so a row is its FOCUS bar, its label, and the row's
// own control laid over them: the engine shows the row's own control and hides
// the other four, and one item template serves all five rows, which is why it
// places all five (format reference §8). A focused row is white, and the bar
// beside it lights: every node inside an item follows the item's control, so the
// bar's own `focused` override and the label's fire together without the control
// painting a border.
//
// `Quit`'s 14px separation is left out by decision, not by oversight: one
// template cannot space its fifth item differently, the five rows are evenly
// spaced instead, and the format gains no property for it.
(
    kind: "box",
    component: "page",
    children: [
        // The pack's backdrop, under the veil.
        (kind: "slot",
            slot: "title.backdrop",
            position: "absolute",
            left: 0.0,
            top: 0.0,
            width: "fill",
            height: "fill",
        ),
        (kind: "box", component: "veil"),
        (kind: "box",
            position: "absolute",
            left: "{spacing.title-left}",
            top: "{spacing.title-top}",
            width: "{spacing.title-width}",
            direction: "column",
            gap: "{spacing.rows-gap}",
            children: [
                // The wordmark, with the tagline 14px under it when the pack has
                // one.
                (kind: "box",
                    direction: "column",
                    gap: "{spacing.tagline-gap}",
                    width: "fill",
                    children: [
                        (kind: "slot", slot: "pack.name",
                            typography: "{typography.wordmark}",
                            color: "{colors.text}"),
                        (kind: "slot", slot: "title.tagline",
                            typography: "{typography.legend}",
                            color: "{colors.focus}"),
                    ],
                ),
                // The five rows, then Continue's reason line 26px below them.
                (kind: "box",
                    direction: "column",
                    gap: "{spacing.reason-gap}",
                    width: "fill",
                    children: [
                        (kind: "list",
                            list: "title.rows",
                            width: "fill",
                            item: (kind: "box",
                                direction: "row",
                                align_items: "center",
                                width: "fill",
                                padding: (top: "{spacing.row-pad-y}", right: 0.0, bottom: "{spacing.row-pad-y}", left: 0.0),
                                children: [
                                    // §3's focus marker: 12x2, transparent until
                                    // its row is the focused one.
                                    (kind: "box",
                                        width: "{spacing.focus-bar-width}",
                                        height: "{spacing.focus-bar-height}",
                                        fill: "{colors.focus}",
                                        opacity: 0.0,
                                        focused: (opacity: 1.0)),
                                    (kind: "slot", slot: "title.row.label",
                                        typography: "{typography.row}",
                                        color: "{colors.dim}",
                                        focused: (color: "{colors.text}"),
                                        disabled: (color: "{colors.faint}")),
                                    (kind: "slot", slot: "title.continue",
                                        position: "absolute",
                                        left: 0.0,
                                        top: 0.0,
                                        width: "fill",
                                        height: "fill"),
                                    (kind: "slot", slot: "title.new-game",
                                        position: "absolute",
                                        left: 0.0,
                                        top: 0.0,
                                        width: "fill",
                                        height: "fill"),
                                    (kind: "slot", slot: "title.settings",
                                        position: "absolute",
                                        left: 0.0,
                                        top: 0.0,
                                        width: "fill",
                                        height: "fill"),
                                    (kind: "slot", slot: "title.gallery",
                                        position: "absolute",
                                        left: 0.0,
                                        top: 0.0,
                                        width: "fill",
                                        height: "fill"),
                                    (kind: "slot", slot: "title.quit",
                                        position: "absolute",
                                        left: 0.0,
                                        top: 0.0,
                                        width: "fill",
                                        height: "fill"),
                                ],
                            ),
                        ),
                        (kind: "slot", slot: "title.continue-reason",
                            typography: "{typography.legend}",
                            color: "{colors.faint}"),
                    ],
                ),
            ],
        ),
        // §3's legend: the frame's bottom right, 40px in and 26px up.
        (kind: "text",
            text: "title.legend",
            typography: "{typography.legend}",
            fill: "{colors.faint}",
            position: "absolute",
            right: "{spacing.legend-right}",
            bottom: "{spacing.legend-bottom}",
        ),
    ],
)
