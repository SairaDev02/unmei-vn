// The legacy-save target picker: a 460px panel over a black 45% dimmer, the
// heading, the prompt, one row per manual slot and Cancel at the row's end.
//
// The prompt is a copy key, so it is a `text` node; the heading and each row's
// label and state are engine content. The row's own control covers the row, as
// the current picker's whole row is the button.
(
    kind: "box",
    component: "dimmer",
    fill: "{colors.shade}",
    children: [
        (kind: "box",
            component: "panel",
            width: 460.0,
            gap: 10.0,
            children: [
                (kind: "slot", slot: "legacy.heading"),
                (kind: "text",
                    text: "legacy-picker.prompt",
                    typography: "{typography.detail}",
                    fill: "{colors.dim}",
                ),
                (kind: "list",
                    list: "legacy.targets",
                    width: "fill",
                    item: (kind: "box",
                        direction: "column",
                        width: "fill",
                        padding: (top: 8.0, right: 12.0, bottom: 8.0, left: 12.0),
                        border: (width: 2.0, color: "{colors.clear}"),
                        fill: "{colors.button}",
                        children: [
                            (kind: "slot", slot: "legacy.target.label"),
                            (kind: "slot", slot: "legacy.target.detail"),
                            (kind: "slot", slot: "legacy.target.1",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            (kind: "slot", slot: "legacy.target.2",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            (kind: "slot", slot: "legacy.target.3",
                                position: "absolute",
                                left: 0.0,
                                top: 0.0,
                                width: "fill",
                                height: "fill",
                                focused: (border: (width: 2.0, color: "{colors.focus}"))),
                        ],
                    ),
                ),
                (kind: "box",
                    direction: "row",
                    width: "fill",
                    justify_content: "end",
                    children: [
                        (kind: "box",
                            component: "button",
                            children: [
                                (kind: "slot", slot: "legacy.cancel",
                                    focused: (border: (width: 2.0, color: "{colors.focus}"))),
                            ],
                        ),
                    ],
                ),
            ],
        ),
    ],
)
