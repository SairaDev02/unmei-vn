keiko 1
# The demo's opening, played offline: the choice, the reunion decision's authored
# fallback, and the epilogue it lands.
decide ace.greet fallback
setting play.text_speed 0

new-game
expect surface play
expect scene first_meeting
expect speaker "Narrator"
expect revealed
advance
expect speaker "Ace"
expect line "You're not from around here, are you?"
advance
expect choices "Ask about the letter" "Stay silent"
pick "Stay silent"
expect state affinity_level = "low"
expect state met_ace = true
expect speaker "Ace"
expect line contains "Fine, don't talk"
advance
advance
advance
expect scene epilogue
expect speaker "Narrator"
expect line "She is already walking away."
